DATABASE_URL=sqlite:///./intervexa.db
APP_ORIGIN=http://localhost:3000
# Comma-separated additional EXACT origins. Local loopback aliases at APP_ORIGIN's
# port are accepted only in development. Production origins must all use HTTPS.
ALLOWED_ORIGINS=
ENVIRONMENT=development
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Off by default. Enable here AND opt in per repository policy to publish neutral Checks.
GITHUB_PUBLISH_CHECKS=false
# Social sign-in is separate from repository GitHub App access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET=
# Set a random >=32 character value in production
SESSION_SECRET=
# Only connect a separate sandbox service you operate; never the API host.
SANDBOX_URL=
SANDBOX_TOKEN=
